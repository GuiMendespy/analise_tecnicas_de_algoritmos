             assert b[n] == pytest.approx(b_answer[n] / norm, abs=1e-7)
+
+
+class TestBetweennessLazyInit:
+    """Regression tests: per-source P/sigma are built only for reached nodes."""
+
+    def test_empty_graph(self):
+        assert nx.betweenness_centrality(nx.Graph()) == {}
+
+    def test_isolated_nodes(self):
+        G = nx.empty_graph(5)
+        assert nx.betweenness_centrality(G) == dict.fromkeys(range(5), 0.0)
+
+    def test_many_components_matches_per_component(self):
+        # union of paths P3: only the middle node of each has centrality
+        G = nx.disjoint_union_all([nx.path_graph(3) for _ in range(4)])
+        b = nx.betweenness_centrality(G, normalized=False)
+        for c in range(4):
+            assert b[3 * c] == 0 and b[3 * c + 2] == 0
+            assert b[3 * c + 1] == pytest.approx(1.0)
+
+    def test_disconnected_equals_union_of_components(self):
+        G = nx.disjoint_union(nx.gnp_random_graph(30, 0.15, seed=1), nx.cycle_graph(6))
+        full = nx.betweenness_centrality(G, normalized=False)
+        n1 = 30
+        sub1 = nx.betweenness_centrality(G.subgraph(range(n1)), normalized=False)
+        sub2 = nx.betweenness_centrality(G.subgraph(range(n1, n1 + 6)), normalized=False)
+        for v, val in {**sub1, **sub2}.items():
+            assert full[v] == pytest.approx(val)
+
+    def test_weighted_disconnected(self):
+        G = nx.Graph()
+        G.add_weighted_edges_from([(0, 1, 1), (1, 2, 1), (3, 4, 2), (4, 5, 2)])
+        b = nx.betweenness_centrality(G, weight="weight", normalized=False)
+        assert b[1] == pytest.approx(1.0) and b[4] == pytest.approx(1.0)
+        assert b[0] == b[2] == b[3] == b[5] == 0
+
+    def test_directed_disconnected_and_endpoints(self):
+        G = nx.DiGraph([(0, 1), (1, 2), (3, 4)])
+        b = nx.betweenness_centrality(G, normalized=False, endpoints=True)
+        assert b[1] == pytest.approx(3.0)
+        assert set(b) == set(G)
+
+    def test_group_betweenness_disconnected(self):
+        G = nx.disjoint_union(nx.path_graph(4), nx.path_graph(3))
+        assert nx.group_betweenness_centrality(G, [1, 5]) >= 0
